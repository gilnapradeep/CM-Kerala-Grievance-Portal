# Copy to backend/.env and replace the placeholders.
# Never commit backend/.env.

SECRET_KEY=replace_with_a_long_random_secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=cm_kerala_db
DB_USER=postgres
